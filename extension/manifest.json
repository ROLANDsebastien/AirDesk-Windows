{
  "manifest_version": 3,
  "name": "AirDesk Companion",
  "version": "0.2.0",
  "description": "Partage le site de l’onglet actif avec le compagnon AirDesk Windows quand le suivi est activé.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AirDesk Companion",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
